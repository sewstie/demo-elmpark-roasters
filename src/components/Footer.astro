---
import { Phone, ArrowUpRight } from 'lucide-react';
import type { Site } from '../schemas/site';
import Brand from './Brand.astro';
import { address } from '../lib/paths';
interface Props { site: Site }
const { site } = Astro.props;
---
<footer class="site-footer">
  <div class="section-shell">
    <div class="footer-top"><div><Brand business={site.business} /><p>{site.footer.description}</p></div><nav aria-label="Footer navigation">{site.nav.map(link => <a href={link.href}>{link.label}</a>)}</nav><a class="text-link" href={`mailto:${site.business.email}`}>{site.business.email}<ArrowUpRight size={16} aria-hidden="true" /></a></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.footer.copyright}</span><span>{address(site.business)}</span></div>
    {site.demoMode && <p class="footer-demo">{site.footer.demoNotice}</p>}
  </div>
</footer>
<div class="mobile-contact"><a href={`tel:${site.business.phone}`} class="button button-secondary"><Phone size={17} aria-hidden="true" />{site.business.phoneDisplay}</a><a href="#menu" class="button button-primary">{site.hero.primaryCta}<ArrowUpRight size={17} aria-hidden="true" /></a></div>
