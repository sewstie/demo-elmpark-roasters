---
import { X } from 'lucide-react';
import type { Site } from '../schemas/site';
interface Props { banner: Site['banner'] }
const { banner } = Astro.props;
---
<aside class="demo-banner" aria-label="Demo notice">
  <a href={banner.href} target="_blank" rel="noopener">{banner.text}</a>
  <button type="button" aria-label="Dismiss demo notice" onclick="this.parentElement.remove()"><X size={18} aria-hidden="true" /></button>
</aside>
