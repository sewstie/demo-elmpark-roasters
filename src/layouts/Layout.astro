---
import '../styles/global.css';
import type { Site } from '../schemas/site';
import { asset } from '../lib/paths';
import { DAY_NAMES } from '../lib/hours';
interface Props { site: Site; title?: string; noindex?: boolean }
const { site, title = site.seo.title, noindex = false } = Astro.props;
const { business, menu } = site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(asset('/'), Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': ['LocalBusiness', 'CafeOrCoffeeShop', 'Bakery'],
  name: business.name, description: site.seo.description, url: home, telephone: business.phone, email: business.email,
  address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.city,
    addressRegion: business.region, postalCode: business.postalCode, addressCountry: 'US' },
  areaServed: business.serviceArea,
  openingHoursSpecification: business.hours.flatMap((day, index) => day
    ? [{ '@type': 'OpeningHoursSpecification', dayOfWeek: DAY_NAMES[index], opens: day.open, closes: day.close }] : []),
  hasMenu: { '@type': 'Menu', url: `${home}#menu`, hasMenuSection: menu.categories.map(category => ({
    '@type': 'MenuSection', name: category.name,
    hasMenuItem: menu.items.filter(item => item.category === category.id).map(item => ({
      '@type': 'MenuItem', name: item.name, description: item.description,
      offers: { '@type': 'Offer', price: item.price.toFixed(2), priceCurrency: 'USD' },
    })),
  })) },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#faf5ec" />
    <meta name="description" content={site.seo.description} />
    {(noindex || site.demo || site.demoBanner) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body class="bg-background text-foreground">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      // In-page links scroll and move focus without ever putting a hash in the URL.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      function reveal(hash: string, behavior: ScrollBehavior) {
        const target = document.getElementById(decodeURIComponent(hash.slice(1)));
        if (!target) return false;
        target.scrollIntoView({ behavior });
        (document.getElementById(target.getAttribute('aria-labelledby') ?? '') ?? target).focus({ preventScroll: true });
        return true;
      }
      document.addEventListener('click', event => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]:not(.skip-link)');
        if (!link || !reveal(link.hash, reduced.matches ? 'auto' : 'smooth')) return;
        event.preventDefault();
        link.closest('details')?.removeAttribute('open');
      });
      if (location.hash) {
        reveal(location.hash, 'instant');
        history.replaceState(null, '', location.pathname + location.search);
      }
    </script>
  </body>
</html>
