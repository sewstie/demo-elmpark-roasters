---
import Layout from '../layouts/Layout.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import MenuBoard from '../components/islands/MenuBoard';
import Catering from '../components/sections/Catering.astro';
import Reviews from '../components/sections/Reviews.astro';
import Faq from '../components/sections/Faq.astro';
import Visit from '../components/sections/Visit.astro';
import Footer from '../components/Footer.astro';
import data from '../data/site.json';
import { siteSchema } from '../schemas/site';
const site = siteSchema.parse(data);
---
<Layout site={site}>
  {site.demoBanner && <DemoBanner banner={site.banner} />}
  <Header site={site} />
  <StatusBar business={site.business} directionsCta={site.visit.directionsCta} />
  <main id="main">
    <Hero hero={site.hero} menu={site.menu} />
    <Intro intro={site.intro} menu={site.menu} />
    <MenuBoard menu={site.menu} client:visible />
    <Catering site={site} />
    <Reviews reviews={site.reviews} />
    <Faq faq={site.faq} />
    <Visit site={site} />
  </main>
  <Footer site={site} />
</Layout>
